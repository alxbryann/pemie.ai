{
  // tsconfig de la raíz: lo usa @vercel/node para compilar la función
  // `api/server.ts` (busca el tsconfig más cercano hacia arriba y no hay
  // ninguno en `api/`). Sin él tomaría opciones por defecto **sin `strict`**, y
  // zod pierde la inferencia de sus schemas: `safeParse().data` sale con todos
  // los campos opcionales y la compilación de la función falla — Vercel no la
  // genera y `/api/*` cae en el rewrite del SPA. Debe mantenerse alineado con
  // `apps/api/tsconfig.json`.
  //
  // Por lo mismo, el `package.json` de la raíz declara `"type": "module"`:
  // `api/` no tiene package.json propio y sin eso Node carga la función
  // compilada como CommonJS ("Cannot use import statement outside a module").
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["api", "apps/api/src"]
}
